{
  "components": {
    "schemas": {
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "FeedEvent": {
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "Pagination": {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PublishEventRequest": {
        "properties": {
          "content": {
            "example": "Alice deployed version 1.2.0",
            "type": "string"
          },
          "event_type": {
            "enum": [
              "login",
              "upload",
              "comment",
              "notification",
              "report",
              "task",
              "message",
              "sync",
              "status",
              "approval"
            ],
            "example": "notification",
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "content"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ],
        "type": "object"
      },
      "Response": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          },
          "message": {
            "type": "string"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Real-time activity feed system with REST API for event publishing and WebSocket-based live feed updates",
    "title": "Real-Time Activity Feed API",
    "version": "1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            },
            "description": "Login successful"
          }
        },
        "summary": "Login user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            },
            "description": "User information retrieved successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get current user information",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            },
            "description": "Token refreshed successfully"
          }
        },
        "summary": "Refresh access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            },
            "description": "User registered successfully"
          }
        },
        "summary": "Register a new user",
        "tags": [
          "auth"
        ]
      }
    },
    "/events": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/FeedEvent"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Event published successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Publish an event",
        "tags": [
          "feed"
        ]
      }
    },
    "/feed": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "event_type",
            "schema": {
              "enum": [
                "login",
                "upload",
                "comment",
                "notification",
                "report",
                "task",
                "message",
                "sync",
                "status",
                "approval"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/FeedEvent"
                          },
                          "type": "array"
                        },
                        "meta": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Activity feed retrieved successfully"
          }
        },
        "summary": "Get the activity feed with pagination and optional event-type filtering",
        "tags": [
          "feed"
        ]
      }
    },
    "/feed/event-types": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "enum": [
                              "login",
                              "upload",
                              "comment",
                              "notification",
                              "report",
                              "task",
                              "message",
                              "sync",
                              "status",
                              "approval"
                            ],
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Event types retrieved successfully"
          }
        },
        "summary": "Get the supported event types for publishing and filtering",
        "tags": [
          "feed"
        ]
      }
    },
    "/feed/ws": {
      "get": {
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted. The server sends JSON messages matching the standard response envelope with a `FeedEvent` in `data`."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            },
            "description": "Live feed connection could not be established"
          }
        },
        "summary": "Upgrade to a WebSocket for live activity feed updates",
        "tags": [
          "feed"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "API v1",
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "description": "Authentication endpoints",
      "name": "auth"
    },
    {
      "description": "Activity feed and event publishing endpoints",
      "name": "feed"
    }
  ]
}