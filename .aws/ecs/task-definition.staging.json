{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${APP_CPU}",
  "memory": "${APP_MEMORY}",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${CONTAINER_NAME}",
      "image": "public.ecr.aws/docker/library/alpine:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${APP_PORT},
          "hostPort": ${APP_PORT},
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SERVER_HOST", "value": "${SERVER_HOST}" },
        { "name": "SERVER_PORT", "value": "${SERVER_PORT}" },
        { "name": "SERVER_READ_TIMEOUT", "value": "${SERVER_READ_TIMEOUT}" },
        { "name": "SERVER_WRITE_TIMEOUT", "value": "${SERVER_WRITE_TIMEOUT}" },
        { "name": "SERVER_IDLE_TIMEOUT", "value": "${SERVER_IDLE_TIMEOUT}" },
        { "name": "DB_HOST", "value": "${DB_HOST}" },
        { "name": "DB_PORT", "value": "${DB_PORT}" },
        { "name": "DB_NAME", "value": "${DB_NAME}" },
        { "name": "DB_SSLMODE", "value": "${DB_SSLMODE}" },
        { "name": "DB_USER", "value": "${DB_USER}" },
        { "name": "DB_MAX_CONNECTIONS", "value": "${DB_MAX_CONNECTIONS}" },
        { "name": "DB_MAX_IDLE_CONNS", "value": "${DB_MAX_IDLE_CONNS}" },
        { "name": "DB_CONN_MAX_LIFETIME", "value": "${DB_CONN_MAX_LIFETIME}" },
        { "name": "REDIS_HOST", "value": "${REDIS_HOST}" },
        { "name": "REDIS_PORT", "value": "${REDIS_PORT}" },
        { "name": "REDIS_DB", "value": "${REDIS_DB}" },
        { "name": "REDIS_POOL_SIZE", "value": "${REDIS_POOL_SIZE}" },
        { "name": "REDIS_MIN_IDLE_CONNS", "value": "${REDIS_MIN_IDLE_CONNS}" },
        { "name": "JWT_ACCESS_EXPIRY", "value": "${JWT_ACCESS_EXPIRY}" },
        { "name": "JWT_REFRESH_EXPIRY", "value": "${JWT_REFRESH_EXPIRY}" },
        { "name": "LOG_LEVEL", "value": "${LOG_LEVEL}" },
        { "name": "LOG_PRETTY", "value": "${LOG_PRETTY}" },
        { "name": "APP_ENV", "value": "${APP_ENV}" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "${DB_PASSWORD_ARN}" },
        { "name": "JWT_SECRET_KEY", "valueFrom": "${JWT_SECRET_KEY_ARN}" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://127.0.0.1:${APP_PORT}/health >/dev/null 2>&1 || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${ECS_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
